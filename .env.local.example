# ── KRAVA storefront environment ──
# Copy this file to `.env.local` and fill in real values.

# Public site URL (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Medusa backend ──
# Storefront falls back to the local catalogue until USE_MEDUSA=true.
NEXT_PUBLIC_USE_MEDUSA=false
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# ── Stripe (test mode) ──
# Get keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# For webhook verification once you wire up /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── CJ Dropshipping (fulfillment — wired up later) ──
CJ_API_EMAIL=
CJ_API_KEY=
